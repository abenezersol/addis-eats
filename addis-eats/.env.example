# Copy this file to .env.local and edit it there. .env*.local is gitignored; this example is safe to commit.
# Nothing here is prefixed NEXT_PUBLIC_, so none of it is ever sent to the browser.
# Restart the server after changing any value.

# Password of the seeded kitchen-staff account (phone 0911000000), at least 8 characters.
# Leave it empty to use the demo password staff-demo-1234.
STAFF_PASSWORD=

# Admin dashboard login (/admin/login). Leave both empty to use admin / admin-demo-1234.
# Always set your own values before deploying.
ADMIN_USERNAME=
ADMIN_PASSWORD=
