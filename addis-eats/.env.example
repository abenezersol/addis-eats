# Copy to .env.local for local development. Never commit .env.local or production secrets.
# Restart the dev server after changing environment values.

# Local-only demo defaults are used if these three values are blank in development.
# Set unique, strong values in Vercel Preview and Production environments.
STAFF_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Public canonical site URL. Set separately for local, Preview, and Production.
# Local development: http://localhost:3000
# Vercel Preview: use the preview URL assigned to that deployment (or your configured preview domain).
# Production: use your real public domain, e.g. https://addiseats.et
NEXT_PUBLIC_SITE_URL=http://localhost:3000
